generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id               String         @id @default(cuid())
  name             String
  subdomain        String         @unique
  plan             Plan           @default(STARTER)
  stripeCustomerId String?
  settings         Json           @default("{}")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  auditLogs              AuditLog[]
  campaigns              Campaign[]
  contacts               Contact[]
  Conversation           Conversation[]
  courses                Course[]
  events                 Event[]
  funnels                Funnel[]
  lineAccounts           LineAccount[]
  lineProjects           LineProject[]
  lineRichMenus          LineRichMenu[]
  lineAutoReplies        LineAutoReply[]
  orders                 Order[]
  partners               Partner[]
  products               Product[]
  subscriptions          Subscription[]
  tags                   Tag[]
  users                  User[]
  abandonedCarts         AbandonedCart[]
  cartRecoveryCampaigns  CartRecoveryCampaign[]
  sentimentAlerts        SentimentAlert[]
  rfmSegmentDefinitions  RFMSegmentDefinition[]
  pipelines              Pipeline[]
  deals                  Deal[]
  journeys               Journey[]
  forms                  Form[]
  abTests                ABTest[]

  @@index([subdomain])
}

model User {
  id          String   @id @default(cuid())
  tenantId    String
  email       String
  name        String?
  role        UserRole @default(MEMBER)
  clerkUserId String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([clerkUserId])
}

model Contact {
  id                  String              @id @default(cuid())
  tenantId            String
  email               String?
  lineUserId          String?
  phone               String?
  name                String?
  firstName           String?
  lastName            String?
  score               Int                 @default(0)
  customFields        Json                @default("{}")
  source              String?
  sourceDetail        Json?
  emailOptIn          Boolean             @default(true)
  emailOptInAt        DateTime?
  lineOptIn           Boolean             @default(true)
  lineOptInAt         DateTime?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  referredByPartnerId String?
  smsOptIn            Boolean             @default(true)
  smsOptInAt          DateTime?
  whatsappNumber      String?
  whatsappOptIn       Boolean             @default(true)
  whatsappOptInAt     DateTime?
  lineAccountId       String?
  lifecycleStage      LifecycleStage      @default(SUBSCRIBER)
  campaignContacts    CampaignContact[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lineAccount         LineAccount?        @relation("LineAccountContacts", fields: [lineAccountId], references: [id])
  tags                ContactTag[]
  Conversation        Conversation[]
  courseEnrollments   CourseEnrollment[]
  eventRegistrations  EventRegistration[]
  messageHistories    MessageHistory[]
  orders              Order[]
  subscriptions       Subscription[]
  abandonedCarts      AbandonedCart[]
  deals               Deal[]
  campaignExecutions  CampaignExecution[]

  @@unique([tenantId, email])
  @@unique([tenantId, lineUserId])
  @@index([tenantId])
  @@index([tenantId, email])
  @@index([tenantId, lineUserId])
}

model Tag {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  contacts  ContactTag[]
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

model ContactTag {
  id        String   @id @default(cuid())
  contactId String
  tagId     String
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@index([contactId])
  @@index([tagId])
}

model Campaign {
  id                 String            @id @default(cuid())
  tenantId           String
  name               String
  type               CampaignType
  status             CampaignStatus    @default(DRAFT)
  segmentId          String?
  useOptimalSendTime Boolean           @default(false)
  minScoreThreshold  Int?
  settings           Json              @default("{}")
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  segment            Segment?          @relation(fields: [segmentId], references: [id])
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts           CampaignContact[]
  steps              CampaignStep[]
  executions         CampaignExecution[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([segmentId])
}

model CampaignStep {
  id               String   @id @default(cuid())
  campaignId       String
  order            Int
  type             StepType
  delayDays        Int      @default(0)
  delayHours       Int      @default(0)
  delayMinutes     Int      @default(0)
  sendTime         String?
  subject          String?
  content          Json
  conditions       Json?
  trueBranchOrder  Int?
  falseBranchOrder Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  campaign         Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([campaignId, order])
}

model CampaignContact {
  id          String                @id @default(cuid())
  campaignId  String
  contactId   String
  currentStep Int                   @default(0)
  status      CampaignContactStatus @default(ACTIVE)
  nextStepAt  DateTime?
  startedAt   DateTime              @default(now())
  completedAt DateTime?
  campaign    Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact               @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId])
  @@index([contactId])
  @@index([status, nextStepAt])
}

model CampaignExecution {
  id         String   @id @default(cuid())
  campaignId String
  stepId     String
  contactId  String
  channel    String
  status     String   @default("PENDING")
  sentAt     DateTime?
  error      String?
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([contactId])
  @@index([campaignId, stepId])
}

model MessageHistory {
  id               String           @id @default(cuid())
  tenantId         String
  contactId        String
  channel          MessageChannel
  direction        MessageDirection
  content          Json
  status           MessageStatus    @default(PENDING)
  sentAt           DateTime?
  deliveredAt      DateTime?
  openedAt         DateTime?
  clickedAt        DateTime?
  errorMessage     String?
  metadata         Json?
  createdAt        DateTime         @default(now())
  conversationId   String?
  campaignId       String?
  stepId           String?
  senderType       SenderType       @default(USER)
  sentiment        Sentiment?
  sentimentScore   Float?
  emotions         Json?
  intent           String?
  intentConfidence Float?
  contact          Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  Conversation     Conversation?    @relation(fields: [conversationId], references: [id])

  @@index([tenantId])
  @@index([contactId])
  @@index([tenantId, channel])
  @@index([conversationId])
  @@index([tenantId, sentiment])
  @@index([campaignId])
}

model Funnel {
  id        String       @id @default(cuid())
  tenantId  String
  name      String
  type      String       @default("SALES")
  domain    String?
  status    FunnelStatus @default(DRAFT)
  settings  Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pages     FunnelPage[]
  steps     FunnelStep[]

  @@index([tenantId])
}

model FunnelPage {
  id             String         @id @default(cuid())
  funnelId       String
  name           String
  slug           String
  content        Json           @default("[]")
  seoTitle       String?
  seoDescription String?
  ogImage        String?
  isVariant      Boolean        @default(false)
  variantWeight  Int            @default(50)
  order          Int            @default(0)
  pageViews      Int            @default(0)
  conversions    Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  actions        FunnelAction[]
  steps          FunnelStep[]
  abTestVariants ABTestVariant[]
  funnel         Funnel         @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@unique([funnelId, slug])
  @@index([funnelId])
}

model FunnelStep {
  id        String         @id @default(cuid())
  funnelId  String
  name      String
  type      FunnelStepType
  order     Int            @default(0)
  config    Json           @default("{}")
  pageId    String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  funnel    Funnel         @relation(fields: [funnelId], references: [id], onDelete: Cascade)
  page      FunnelPage?    @relation(fields: [pageId], references: [id])

  @@index([funnelId])
  @@index([funnelId, order])
}

model FunnelAction {
  id        String     @id @default(cuid())
  pageId    String
  type      ActionType
  trigger   String
  config    Json
  createdAt DateTime   @default(now())
  page      FunnelPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Product {
  id                String             @id @default(cuid())
  tenantId          String
  name              String
  description       String?
  price             Int
  currency          String             @default("JPY")
  stripeProductId   String?
  stripePriceId     String?
  type              ProductType        @default(ONE_TIME)
  recurringInterval RecurringInterval?
  courseId          String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  orders            Order[]
  course            Course?            @relation(fields: [courseId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscriptions     Subscription[]

  @@index([tenantId])
}

model Order {
  id                    String      @id @default(cuid())
  tenantId              String
  contactId             String
  productId             String
  amount                Int
  currency              String      @default("JPY")
  status                OrderStatus @default(PENDING)
  stripePaymentIntentId String?
  stripeChargeId        String?
  metadata              Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  contact               Contact     @relation(fields: [contactId], references: [id])
  product               Product     @relation(fields: [productId], references: [id])
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
}

model Subscription {
  id                   String             @id @default(cuid())
  tenantId             String
  contactId            String
  productId            String
  stripeSubscriptionId String?
  status               SubscriptionStatus @default(ACTIVE)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  canceledAt           DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  contact              Contact            @relation(fields: [contactId], references: [id])
  product              Product            @relation(fields: [productId], references: [id])
  tenant               Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([stripeSubscriptionId])
}

model Course {
  id             String              @id @default(cuid())
  tenantId       String
  name           String
  description    String?
  thumbnail      String?
  isPublished    Boolean             @default(false)
  accessMode     String              @default("PUBLIC")
  isPublicCourse Boolean             @default(false)
  shareCode      String?             @unique
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  enrollments    CourseEnrollment[]
  lessons        Lesson[]
  products       Product[]

  @@index([tenantId])
}

model Lesson {
  id                   String           @id @default(cuid())
  courseId             String
  name                 String
  description          String?
  content              Json             @default("{}")
  videoUrl             String?
  videoFileUrl         String?
  thumbnailUrl         String?
  videoType            VideoType?
  duration             Int?
  isPublished          Boolean          @default(false)
  releaseDelay         Int              @default(0)
  requiredRank         MemberRank       @default(BRONZE)
  isSequentialStart    Boolean          @default(false)
  requireCompletion    Boolean          @default(false)
  completionThreshold  Int              @default(80)
  order                Int              @default(0)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  course               Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress             LessonProgress[]

  @@index([courseId])
  @@index([courseId, order])
}

model CourseEnrollment {
  id         String    @id @default(cuid())
  courseId   String
  contactId  String
  enrolledAt DateTime  @default(now())
  expiresAt  DateTime?
  contact    Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  course     Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, contactId])
  @@index([courseId])
  @@index([contactId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  lessonId       String
  contactId      String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  watchedSeconds Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, contactId])
  @@index([lessonId])
  @@index([contactId])
}

model Event {
  id            String              @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  type          EventType
  startAt       DateTime
  endAt         DateTime
  timezone      String              @default("Asia/Tokyo")
  location      String?
  isOnline      Boolean             @default(true)
  meetingUrl    String?
  capacity      Int?
  status        EventStatus         @default(SCHEDULED)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  tenant        Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  liveStreams    LiveStream[]

  @@index([tenantId])
  @@index([tenantId, startAt])
}

model EventRegistration {
  id                        String                  @id @default(cuid())
  eventId                   String
  contactId                 String
  status                    EventRegistrationStatus @default(REGISTERED)
  registeredAt              DateTime                @default(now())
  attendedAt                DateTime?
  canceledAt                DateTime?
  dayBeforeReminderSent     Boolean                 @default(false)
  dayBeforeReminderSentAt   DateTime?
  hourBeforeReminderSent    Boolean                 @default(false)
  hourBeforeReminderSentAt  DateTime?
  contact                   Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  event                     Event                   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, contactId])
  @@index([eventId])
  @@index([contactId])
}

model Partner {
  id                   String                @id @default(cuid())
  tenantId             String
  email                String
  name                 String
  code                 String                @unique
  commissionRate       Int                   @default(30)
  status               PartnerStatus         @default(PENDING)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  minimumPayoutAmount  Int                   @default(5000)
  coolingPeriodDays    Int                   @default(30)
  partnerAccessToken   String?               @unique
  tokenExpiresAt       DateTime?
  lineUserId           String?
  notifyConversion     Boolean               @default(true)
  notifyPayout         Boolean               @default(true)
  bio                  String?
  websiteUrl           String?
  bankAccountInfo      Json?
  commissions          AffiliateCommission[]
  affiliateConversions AffiliateConversion[]
  affiliateLinks       AffiliateLink[]
  payouts              AffiliatePayout[]
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  Referral             Referral[]
  onboarding           AffiliateOnboarding?

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([code])
}

model AffiliateOnboarding {
  id               String   @id @default(cuid())
  partnerId        String   @unique
  partner          Partner  @relation(fields: [partnerId], references: [id])
  profileComplete  Boolean  @default(false)
  channelSelected  Boolean  @default(false)
  firstLinkCopied  Boolean  @default(false)
  firstConversion  Boolean  @default(false)
  completionScore  Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AffiliateLink {
  id                  String                @id @default(cuid())
  tenantId            String
  partnerId           String
  url                 String
  linkCode            String                @unique
  code                String?
  productId           String?
  clicks              Int                   @default(0)
  conversions         Int                   @default(0)
  revenue             Int                   @default(0)
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  AffiliateClick      AffiliateClick[]
  AffiliateConversion AffiliateConversion[]
  partner             Partner               @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([linkCode])
  @@index([tenantId])
}

model AffiliateClick {
  id            String        @id @default(cuid())
  tenantId      String
  linkId        String
  partnerId     String?
  ipAddress     String?
  userAgent     String?
  referrer      String?
  clickedAt     DateTime?
  createdAt     DateTime      @default(now())
  AffiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([linkId])
  @@index([tenantId])
  @@index([createdAt])
}

model AffiliateConversion {
  id            String          @id @default(cuid())
  tenantId      String
  partnerId     String
  linkId        String?
  orderId       String?
  amount        Int
  commissions   Json?
  status        AffiliateStatus @default(PENDING)
  approvedAt    DateTime?
  payableAt     DateTime?
  createdAt     DateTime        @default(now())
  AffiliateLink AffiliateLink?  @relation(fields: [linkId], references: [id])
  partner       Partner         @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partnerId])
  @@index([status])
}

model AffiliateCommission {
  id            String           @id @default(cuid())
  tenantId      String
  partnerId     String
  amount        Int
  percentage    Int
  type          String?
  tier          String?
  status        CommissionStatus @default(PENDING)
  paidAt        DateTime?
  paymentMethod String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  partner       Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partnerId])
  @@index([status])
}

model AffiliatePayout {
  id             String       @id @default(cuid())
  tenantId       String
  partnerId      String
  amount         Int
  currency       String       @default("JPY")
  status         PayoutStatus @default(PENDING)
  paymentMethod  String?
  paymentDetails Json?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  partner        Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([partnerId])
  @@index([status])
}

model LineRichMenu {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  lineRichMenuId String?
  size           Json
  areas          Json
  imageUrl       String?
  conditions     Json?
  tabGroup       String?
  tabOrder       Int?     @default(0)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model LineAutoReply {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  keyword     String
  matchType   String   @default("contains") // exact, contains, startsWith, regex
  replyType   String   @default("text") // text, flex, image, video, sticker
  replyContent Json    // { text?: string, altText?: string, contents?: FlexContents, ... }
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model AutomationRule {
  id          String                @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isActive    Boolean               @default(false)
  aiEnabled   Boolean               @default(false)
  aiConfig    Json?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  actions     AutomationAction[]
  executions  AutomationExecution[]
  triggers    AutomationTrigger[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

model AutomationTrigger {
  id         String         @id @default(cuid())
  ruleId     String
  type       TriggerType
  conditions Json           @default("[]")
  logicalOp  String         @default("AND")
  createdAt  DateTime       @default(now())
  rule       AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
}

model AutomationAction {
  id           String               @id @default(cuid())
  ruleId       String
  type         AutomationActionType
  config       Json                 @default("{}")
  delayDays    Int                  @default(0)
  delayHours   Int                  @default(0)
  delayMinutes Int                  @default(0)
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  rule         AutomationRule       @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([ruleId, order])
}

model AutomationExecution {
  id           String          @id @default(cuid())
  ruleId       String
  contactId    String
  status       ExecutionStatus @default(PENDING)
  aiDecision   Json?
  aiConfidence Float?
  triggeredAt  DateTime        @default(now())
  completedAt  DateTime?
  errorMessage String?
  rule         AutomationRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([contactId])
  @@index([status])
  @@index([triggeredAt])
}

model ContactScore {
  id              String    @id @default(cuid())
  contactId       String    @unique
  tenantId        String
  recency         Int       @default(1)
  frequency       Int       @default(1)
  monetary        Int       @default(1)
  rfmSegment      String?
  previousSegment String?
  totalScore      Int       @default(0)
  leadScore       Int       @default(0)
  engagementScore Int       @default(0)
  churnScore      Int       @default(0)
  tier            String    @default("cold")
  lastPurchaseDate DateTime?
  totalPurchases  Int       @default(0)
  totalSpent      Float     @default(0)
  avgOrderValue   Float     @default(0)
  calculatedAt    DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tenantId])
  @@index([tenantId, rfmSegment])
  @@index([tenantId, tier])
  @@index([tenantId, totalScore])
  @@index([leadScore])
}

model BehaviorEvent {
  id         String            @id @default(cuid())
  tenantId   String
  contactId  String
  type       BehaviorEventType
  data       Json              @default("{}")
  source     String?
  sessionId  String?
  deviceType String?
  ipAddress  String?
  occurredAt DateTime          @default(now())

  @@index([tenantId])
  @@index([contactId])
  @@index([tenantId, type])
  @@index([occurredAt])
}

model Segment {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String           @default("#6366f1")
  rules       Json             @default("[]")
  rulesLogic  String           @default("AND")
  autoUpdate  Boolean          @default(true)
  memberCount Int              @default(0)
  priority    Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  campaigns   Campaign[]
  contacts    ContactSegment[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, autoUpdate])
}

model ContactSegment {
