  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  contact         Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([contactId])
  @@index([tenantId, isRecovered])
  @@index([tenantId, status])
  @@index([abandonedAt])
}

model CartRecoveryCampaign {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  isActive        Boolean  @default(true)
  channel         String
  timing          Json
  discountType    String?
  discountValue   Int?
  discountCode    String?
  conditions      Json?
  sentCount       Int      @default(0)
  recoveredCount  Int      @default(0)
  recoveredAmount Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

// ==================== センチメントアラート ====================

model SentimentAlert {
  id             String        @id @default(cuid())
  tenantId       String
  contactId      String
  conversationId String?
  alertType      String
  severity       AlertSeverity @default(MEDIUM)
  sentiment      Sentiment
  sentimentScore Float
  context        Json?
  isResolved     Boolean       @default(false)
  resolvedAt     DateTime?
  resolvedBy     String?
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isResolved])
  @@index([contactId])
  @@index([createdAt])
  @@index([tenantId, severity])
}

// ==================== RFMセグメント定義 ====================

model RFMSegmentDefinition {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String   @default("#6366f1")
  rMin        Int
  rMax        Int
  fMin        Int
  fMax        Int
  mMin        Int
  mMax        Int
  priority    Int      @default(0)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, name])
  @@index([tenantId])
}

// ==================== CRM Pipeline ====================

model Pipeline {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  stages    PipelineStage[]
  deals     Deal[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model PipelineStage {
  id          String   @id @default(cuid())
  pipelineId  String
  name        String
  order       Int
  color       String   @default("#6366f1")
  probability Int      @default(50)
  deals       Deal[]
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)

  @@index([pipelineId])
}

model Deal {
  id         String         @id @default(cuid())
  tenantId   String
  pipelineId String
  stageId    String
  contactId  String?
  title      String
  amount     Int            @default(0)
  currency   String         @default("JPY")
  status     DealStatus     @default(OPEN)
  closedAt   DateTime?
  assigneeId String?
  activities DealActivity[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  pipeline   Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage      PipelineStage  @relation(fields: [stageId], references: [id])
  contact    Contact?       @relation(fields: [contactId], references: [id])

  @@index([tenantId])
  @@index([pipelineId])
  @@index([stageId])
}

model DealActivity {
  id        String   @id @default(cuid())
  dealId    String
  type      String
  body      String
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId])
}

// ==================== Journey Builder ====================

model Journey {
  id          String        @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      JourneyStatus @default(DRAFT)
  nodes       JourneyNode[]
  edges       JourneyEdge[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model JourneyNode {
  id        String          @id @default(cuid())
  journeyId String
  type      JourneyNodeType
  label     String
  positionX Float           @default(0)
  positionY Float           @default(0)
  config    Json            @default("{}")
  journey   Journey         @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  outEdges  JourneyEdge[]   @relation("SourceNode")
  inEdges   JourneyEdge[]   @relation("TargetNode")

  @@index([journeyId])
}

model JourneyEdge {
  id        String      @id @default(cuid())
  journeyId String
  sourceId  String
  targetId  String
  label     String?
  journey   Journey     @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  source    JourneyNode @relation("SourceNode", fields: [sourceId], references: [id], onDelete: Cascade)
  target    JourneyNode @relation("TargetNode", fields: [targetId], references: [id], onDelete: Cascade)

  @@index([journeyId])
}

// ==================== Form Builder ====================

model Form {
  id          String           @id @default(cuid())
  tenantId    String
  name        String
  description String?
  status      FormStatus       @default(DRAFT)
  fields      FormField[]
  submissions FormSubmission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model FormField {
  id          String  @id @default(cuid())
  formId      String
  type        String
  label       String
  placeholder String?
  required    Boolean @default(false)
  options     Json?
  order       Int
  form        Form    @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model FormSubmission {
  id        String   @id @default(cuid())
  formId    String
  data      Json
  ipAddress String?
  createdAt DateTime @default(now())
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// ==================== A/B Testing ====================

model ABTest {
  id        String          @id @default(cuid())
  tenantId  String
  name      String
  status    ABTestStatus    @default(DRAFT)
  algorithm ABTestAlgorithm @default(EQUAL_WEIGHT)
  funnelId  String?
  variants  ABTestVariant[]
  results   ABTestResult[]
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ABTestVariant {
  id      String         @id @default(cuid())
  testId  String
  name    String
  weight  Int            @default(50)
  pageId  String?
  results ABTestResult[]
  test    ABTest         @relation(fields: [testId], references: [id], onDelete: Cascade)
  page    FunnelPage?    @relation(fields: [pageId], references: [id])

  @@index([testId])
}

model ABTestResult {
  id          String        @id @default(cuid())
  testId      String
  variantId   String
  impressions Int           @default(0)
  conversions Int           @default(0)
  date        DateTime      @default(now())
  test        ABTest        @relation(fields: [testId], references: [id], onDelete: Cascade)
  variant     ABTestVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([variantId])
}

