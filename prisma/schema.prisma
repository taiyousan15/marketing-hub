  @@unique([tenantId, name])
  @@index([tenantId])
}

model LineAccount {
  id              String       @id @default(cuid())
  tenantId        String
  projectId       String?
  name            String
  channelId       String
  channelSecret   String
  accessToken     String
  botUserId       String?
  botBasicId      String?
  botDisplayName  String?
  botPictureUrl   String?
